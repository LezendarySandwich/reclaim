# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
.output/
.wxt/
*.zip
*.crx
*.pem
*.xpi

# test & coverage
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# model weights — never commit these, they are downloaded at runtime
*.wasm.bin
*.gguf
*.onnx
models/cache/

# local captures used as adapter fixtures are committed deliberately;
# raw unredacted scrapes are not
fixtures/raw/

# env & secrets
.env
.env.*
!.env.example

# editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Throwaway Chrome profile created by the S2 spike harness. 8MB of caches, metrics and
# machine-identifying state that a broad `git add` will otherwise sweep in.
scripts/spikes/*/profile/
scripts/spikes/*/results.jsonl
scripts/spikes/*/chrome.log
scripts/spikes/*/srv.log
